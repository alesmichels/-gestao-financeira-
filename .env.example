# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.

# Token do bot, gerado pelo @BotFather no Telegram
TELEGRAM_TOKEN=coloque-o-token-aqui

# ID do grupo do casal (número negativo). Deixe vazio até descobrir com /id dentro do grupo.
GRUPO_AUTORIZADO=

# Onde fica o banco de dados (um único arquivo)
DB_PATH=dados/financas.db

# Fuso horário usado para datas
FUSO=America/Sao_Paulo
